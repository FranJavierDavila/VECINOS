{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "grid": {
      "type": "object",
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "floors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cols",
        "floors"
      ],
      "additionalProperties": false
    },
    "rows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "floors": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "blocks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "col": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "defId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "tag": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "col",
                "defId",
                "tag"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "floors",
          "blocks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "grid",
    "rows"
  ],
  "additionalProperties": false
}
