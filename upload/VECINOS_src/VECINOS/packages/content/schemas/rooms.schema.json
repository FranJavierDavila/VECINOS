{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "type": "string",
      "const": "room"
    },
    "size": {
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": "number"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "enum"
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "values",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "furnitureSlots": {
      "default": [],
      "type": "array",
      "items": {}
    },
    "view": {
      "type": "object",
      "properties": {
        "prefab": {
          "type": "string"
        },
        "lodFar": {
          "type": "string"
        },
        "sprite": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "size"
  ],
  "additionalProperties": false
}
