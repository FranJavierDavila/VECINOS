{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rooms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "defId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "startsUnlocked": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "defId",
          "startsUnlocked"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "rooms"
  ],
  "additionalProperties": false
}
