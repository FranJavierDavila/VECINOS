{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "common",
        "dwelling",
        "commercial",
        "infrastructure"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "main",
        "corridor"
      ]
    },
    "size": {
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "traversable": {
      "type": "boolean"
    },
    "alignGroup": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "childKind": {
          "type": "string",
          "const": "room"
        },
        "layout": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "childKind",
        "layout"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "connectsTo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "side"
        ],
        "additionalProperties": false
      }
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": "number"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "enum"
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "values",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "prefab": {
          "type": "string"
        },
        "lodFar": {
          "type": "string"
        },
        "sprite": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "layer",
    "size"
  ],
  "additionalProperties": false
}
