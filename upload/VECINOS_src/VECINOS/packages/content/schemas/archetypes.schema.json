{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "traits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sleep",
          "social",
          "fun",
          "money"
        ]
      }
    },
    "activities": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "emits": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "gossipGain": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "prefab": {
          "type": "string"
        },
        "lodFar": {
          "type": "string"
        },
        "sprite": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "traits",
    "needs"
  ],
  "additionalProperties": false
}
